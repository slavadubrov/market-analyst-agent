# Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Required: Tavily API key for web search
TAVILY_API_KEY=your-tavily-api-key-here

# Hot memory provider (postgres or redis)
HOT_MEMORY_PROVIDER=postgres

# PostgreSQL connection (defaults for docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=market_analyst
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst_pass

# Redis connection (defaults for docker-compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Qdrant (for docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Part 5 (The Habitat) ---------------------------------------------------

# OpenTelemetry — leave blank to disable tracing (default). Set to an OTLP
# endpoint to enable, e.g. `http://localhost:4317` when the observability
# profile is up (`docker compose --profile observability up`).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=market-analyst-agent

# Prometheus /metrics endpoint exposed by the worker. Off by default.
METRICS_ENABLED=false
METRICS_PORT=9464

# Workspace + idempotency stores.
WORKSPACE_ROOT=./workspaces
IDEMPOTENCY_ROOT=./.idempotency

# Redis Streams queue (queue+worker shape). RUN_QUEUE_STREAM / RUN_QUEUE_GROUP
# only matter if you run `python -m market_analyst.runtime.worker`.
RUN_QUEUE_STREAM=market_analyst:runs
RUN_QUEUE_GROUP=workers

# MCP sidecar. Stdio is the canonical MCP transport; the docker-compose
# sidecar uses HTTP so the worker container can reach it over the bridge.
MCP_TRANSPORT=stdio
MCP_PORT=8765

# Checkpoint encryption (production). Leave blank in dev. When set, the
# Postgres checkpointer wraps payloads with EncryptedSerializer. Pair with
# LANGGRAPH_STRICT_MSGPACK=true to defend against deserialization attacks.
CHECKPOINT_ENCRYPTION_KEY=
LANGGRAPH_STRICT_MSGPACK=false
